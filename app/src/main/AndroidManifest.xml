<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.faketouch" android:required="false" />
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />
    <uses-feature android:name="android.hardware.type.television" android:required="false" />


    <uses-permission android:name="android.permission.INTERNET" />
<application
        android:icon="@drawable/scottibyte_multiview_launcher_legacy"
        android:roundIcon="@drawable/scottibyte_multiview_launcher_legacy"
        android:banner="@drawable/tv_banner"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:label="ScottiBYTE MultiView"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScottiBYTEMultiView">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:screenOrientation="landscape"
            android:icon="@drawable/scottibyte_multiview_launcher_legacy"
            android:roundIcon="@drawable/scottibyte_multiview_launcher_legacy"
            android:logo="@drawable/scottibyte_multiview_launcher_legacy"
            android:banner="@drawable/tv_banner"
            android:label="ScottiBYTE MultiView">
</activity>

        <activity
            android:name=".TvLauncherActivity"
            android:exported="true"
            android:label="ScottiBYTE MultiView"
            android:icon="@drawable/scottibyte_multiview_launcher_legacy"
            android:roundIcon="@drawable/scottibyte_multiview_launcher_legacy"
            android:banner="@drawable/tv_banner"
            android:theme="@style/Theme.ScottiBYTEMultiView">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
